generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  VERIFIED
  ESTIMATED
  UNVERIFIED
}

enum MigrationAlignment {
  STRONG
  MODERATE
  LIMITED
  UNKNOWN
}

model University {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  website     String?
  cricosCode  String?
  description String?
  campuses    Campus[]
  courses     Course[]
  scholarships Scholarship[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campus {
  id            String   @id @default(cuid())
  universityId  String
  university    University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name          String
  city          String
  state         String
  postcode      String?
  regional      Boolean  @default(false)
  latitude      Float?
  longitude     Float?
  livingCosts   LivingCost[]
  courseCampuses CourseCampus[]
}

model StudyField {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  parentId  String?
  parent    StudyField? @relation("FieldHierarchy", fields: [parentId], references: [id])
  children  StudyField[] @relation("FieldHierarchy")
  courses   Course[]
}

model Course {
  id                 String   @id @default(cuid())
  universityId       String
  university         University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  studyFieldId       String?
  studyField         StudyField? @relation(fields: [studyFieldId], references: [id])
  name               String
  slug               String
  qualificationLevel String
  cricosCode         String?
  durationMonths     Int?
  annualFee          Decimal? @db.Decimal(12,2)
  totalFee           Decimal? @db.Decimal(12,2)
  currency           String @default("AUD")
  description        String?
  sourceUrl          String?
  verifiedAt         DateTime?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  campuses           CourseCampus[]
  requirements       EntryRequirement[]
  subjects           CourseSubject[]
  occupations        CourseOccupation[]
  scholarships       CourseScholarship[]
  intakes            CourseIntake[]
  savedBy            SavedCourse[]
  @@unique([universityId, slug])
}

model CourseCampus {
  courseId String
  campusId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  @@id([courseId, campusId])
}

model EntryRequirement {
  id            String @id @default(cuid())
  courseId      String
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicText  String?
  minimumGpa    Float?
  relevantFieldRequired Boolean @default(false)
  ieltsOverall  Float?
  pteOverall    Float?
  sourceUrl     String?
  verifiedAt    DateTime?
}

model Subject {
  id          String @id @default(cuid())
  code        String?
  name        String
  description String?
  courses     CourseSubject[]
}

model CourseSubject {
  courseId String
  subjectId String
  isCore   Boolean @default(true)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@id([courseId, subjectId])
}

model Occupation {
  id             String @id @default(cuid())
  code           String? @unique
  name           String
  description    String?
  assessingAuthority String?
  sourceUrl      String?
  verifiedAt     DateTime?
  courses        CourseOccupation[]
  visaPathways   OccupationVisaPathway[]
}

model CourseOccupation {
  courseId       String
  occupationId   String
  alignmentScore Int?
  course         Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  occupation     Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  @@id([courseId, occupationId])
}

model VisaPathway {
  id          String @id @default(cuid())
  subclass    String
  name        String
  description String?
  sourceUrl   String?
  verifiedAt  DateTime?
  occupations OccupationVisaPathway[]
}

model OccupationVisaPathway {
  occupationId String
  visaPathwayId String
  alignment MigrationAlignment @default(UNKNOWN)
  notes      String?
  effectiveFrom DateTime?
  effectiveTo DateTime?
  occupation Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  visaPathway VisaPathway @relation(fields: [visaPathwayId], references: [id], onDelete: Cascade)
  @@id([occupationId, visaPathwayId])
}

model Scholarship {
  id           String @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  amount       Decimal? @db.Decimal(12,2)
  percentage   Float?
  eligibility  String?
  sourceUrl    String?
  verifiedAt   DateTime?
  courses      CourseScholarship[]
}

model CourseScholarship {
  courseId      String
  scholarshipId String
  course         Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scholarship    Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  @@id([courseId, scholarshipId])
}

model CourseIntake {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  month    Int
  year     Int
}

model LivingCost {
  id          String @id @default(cuid())
  campusId    String
  campus      Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  category    String
  weeklyLow   Decimal? @db.Decimal(10,2)
  weeklyHigh  Decimal? @db.Decimal(10,2)
  monthlyEstimate Decimal? @db.Decimal(10,2)
  sourceUrl   String?
  verifiedAt  DateTime?
  verificationStatus VerificationStatus @default(ESTIMATED)
}

model StudentProfile {
  id                 String @id @default(cuid())
  userId             String? @unique
  nationality        String?
  currentCountry     String?
  highestQualification String?
  qualificationField String?
  institution        String?
  gpa                Float?
  graduationYear     Int?
  currentOccupation  String?
  yearsExperience    Float?
  desiredOccupation  String?
  desiredIndustry    String?
  preferredQualification String?
  annualTuitionBudget Decimal? @db.Decimal(12,2)
  totalBudget        Decimal? @db.Decimal(12,2)
  monthlyLivingBudget Decimal? @db.Decimal(12,2)
  preferredStates    String[]
  preferredCities    String[]
  regionalAccepted   Boolean @default(true)
  migrationGoal      String?
  englishTest        String?
  englishOverall     Float?
  dependants         Int @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SavedCourse {
  id        String @id @default(cuid())
  userId    String
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, courseId])
}
